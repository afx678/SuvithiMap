# ==========================================================
# SuVithiMap Environment Configuration (.env)
# ==========================================================

# 1. Supabase PostgreSQL & Storage Settings
# Optional: If left blank or unreachable, SuVithiMap automatically falls back
# to high-performance local in-memory/SQLite persistence.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# 2. Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 3. AI & Vision Service
AI_CONFIDENCE_THRESHOLD=0.55
ENABLE_GPU_INFERENCE=false
DEMO_FALLBACK_MODE=true

# 4. Simulation Engine Defaults
SIMULATION_BUS_COUNT=10
SIMULATION_DEFAULT_SCENARIO=normal
SIMULATION_TICK_RATE_MS=1500
